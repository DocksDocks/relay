#!/bin/sh
# relay — launcher for the externally installed relay CLI.
# PATH and HOME lookup skip this launcher and any relay that fails the
# --version identity probe; an explicit RELAY_BIN is trusted and a RELAY_BIN
# that points at the launcher fails as recursion.

canonical_path() {
  path=$1
  case "$path" in
    /*) ;;
    *) path=$PWD/$path ;;
  esac

  hops=0
  while [ -L "$path" ]; do
    [ "$hops" -lt 40 ] || return 1
    hops=$((hops + 1))
    target=$(PATH=/usr/bin:/bin readlink "$path") || return 1
    case "$target" in
      /*) path=$target ;;
      *)
        parent=${path%/*}
        [ -n "$parent" ] || parent=/
        path=$parent/$target
        ;;
    esac
  done

  directory=${path%/*}
  [ -n "$directory" ] || directory=/
  base=${path##*/}
  directory=$(CDPATH='' cd -P "$directory" 2>/dev/null && pwd) || return 1
  printf '%s/%s\n' "$directory" "$base"
}

fail_invalid() {
  printf 'relay launcher: RELAY_BIN is not an executable file: %s\n' "$1" >&2
  exit 1
}

fail_recursion() {
  printf 'relay launcher: refusing to execute itself recursively: %s\n' "$1" >&2
  exit 1
}

launcher=$(canonical_path "$0") || {
  printf 'relay launcher: cannot resolve launcher path: %s\n' "$0" >&2
  exit 1
}

# Accept a lookup candidate only when it is an executable file, is not this
# launcher, and answers --version with the relay prefix. stdin is closed for
# the probe so an unrelated relay cannot block or drain the session stream.
accept_candidate() {
  [ -f "$1" ] && [ -x "$1" ] || return 1
  [ "$(canonical_path "$1" 2>/dev/null)" != "$launcher" ] || return 1
  case "$("$1" --version </dev/null 2>/dev/null)" in
    'relay '*) return 0 ;;
    *) return 1 ;;
  esac
}

candidate=
if [ -n "${RELAY_BIN:-}" ]; then
  candidate=$RELAY_BIN
  if [ ! -f "$candidate" ] || [ ! -x "$candidate" ]; then
    fail_invalid "$candidate"
  fi
else
  path_list=${PATH:-}
  while [ -n "$path_list" ]; do
    entry=${path_list%%:*}
    if [ "$entry" = "$path_list" ]; then
      path_list=
    else
      path_list=${path_list#*:}
    fi
    [ -n "$entry" ] || entry=.
    if accept_candidate "$entry/relay"; then
      candidate=$entry/relay
      break
    fi
  done

  if [ -z "$candidate" ] && [ -n "${HOME:-}" ] && accept_candidate "$HOME/.local/bin/relay"; then
    candidate=$HOME/.local/bin/relay
  fi

  if [ -z "$candidate" ]; then
    printf '%s\n' \
      'relay executable not found.' \
      "Download relay-$(uname -m)-unknown-linux-musl from" \
      'https://github.com/DocksDocks/relay/releases/latest' \
      'and install it as ~/.local/bin/relay' >&2
    exit 1
  fi
fi

resolved=$(canonical_path "$candidate") || {
  if [ -n "${RELAY_BIN:-}" ]; then
    fail_invalid "$candidate"
  fi
  printf 'relay launcher: cannot resolve executable path: %s\n' "$candidate" >&2
  exit 1
}

if [ "$resolved" = "$launcher" ]; then
  fail_recursion "$candidate"
fi

exec "$candidate" "$@"
